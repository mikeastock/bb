{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bb-connect",
  "main": "./src/worker.ts",
  "account_id": "26dace28f8bcc23d105d7c198c69e7c8",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "workers_dev": false,
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TunnelDO"] }],
  "durable_objects": {
    "bindings": [{ "name": "TUNNEL_DO", "class_name": "TunnelDO" }]
  },
  "vars": {
    "BASE_DOMAIN": "buildr-bb.com",
    "ACCOUNT_APP_URL": "https://bb.buildr-bb.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bb-connect-prod",
      "database_id": "7ad976bb-23b9-4bb4-8d82-c01658da6e27",
      "migrations_dir": "../../packages/connect-db/migrations"
    }
  ],
  "analytics_engine_datasets": [
    { "binding": "GATE_EVENTS", "dataset": "bb_connect_gate_events" }
  ],
  "routes": [{ "pattern": "*.buildr-bb.com/*", "zone_name": "buildr-bb.com" }]
}
